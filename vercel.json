{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "https://dashboard-games.onrender.com/api/admin/:path*"
    },
    {
      "source": "/api/telemetry",
      "destination": "https://dashboard-games.onrender.com/api/telemetry"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ]
}
