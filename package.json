{
  "name": "nha-choi",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/game-core",
    "packages/protocol",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @nha-choi/web",
    "dev:server": "npm run dev --workspace @nha-choi/server",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build:shared && npm run build --workspace @nha-choi/web",
    "typecheck": "tsc -b",
    "lint": "eslint packages apps --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:shared": "npm run build --workspace @nha-choi/game-core && npm run build --workspace @nha-choi/protocol",
    "predev:web": "npm run build:shared",
    "predev:server": "npm run build:shared",
    "pretest:e2e": "npm run build:web"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "29.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
