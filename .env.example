# Backend: environment variables passed to the server process
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Web: put VITE_* in apps/web/.env.local before building.
# Empty = same-origin /socket.io (reverse proxy in production).
# VITE_SERVER_URL=https://games.example.com
# Native builds require an explicit HTTPS server URL for online play.
# BACKEND_PROXY_URL=http://127.0.0.1:3001

# Backend only; never prefix this with VITE_ or commit real credentials.
# Omit/leave empty for explicit temporary in-memory development mode.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require

# Optional admin dashboard. Set both on the backend.
# ADMIN_ORIGIN=https://your-web.example
# ADMIN_PASSWORD_HASH=<32 hex salt>:<128 hex scrypt hash>
# Optional: raise only behind a proxy that rate-limits by client. Default 30 requests/minute per peer.
# TELEMETRY_PEER_LIMIT=300

# Optional provider build status, backend only. Use tokens with the least available access.
# RENDER_API_KEY=
# RENDER_SERVICE_ID=  # Render normally supplies this automatically.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=     # For projects owned by a Vercel team.
